#!/bin/sh
# Refuse a push whose provenance or destination cannot be established.
#
# This repository was extracted from a monorepo that carried these guards. They came with it
# because the code they protect came with it — a repository that builds a public surface and holds
# no secret scanner is one secret away from a bad afternoon.
#
# Until 22 Sep 2026 this hook demanded that the destination be PRIVATE, and failed closed on
# anything else. The repository is now published deliberately: it carries the site that is served
# at projectxprotocol.dev, and the licence in README and LICENSE states that publication grants no
# licence to use it. So the destination check no longer asks whether the repository is private. It
# asks whether it is the one repository this checkout is allowed to publish to, which is the guard
# that still means something once "private" is no longer the answer.
#
# What has not changed: no linked worktrees, no detached HEAD, no rewriting history that is already
# on the remote, and the secret scanner runs over everything about to leave this machine rather
# than only over the last commit.
set -e
refs="$(cat)"

# The only destination this checkout may push to.
ALLOWED_REPO="github.com/Northlatch-Labs-LLC/projectx-website"

if [ "$GIT_PUSH_ANYWAY" != "1" ]; then
  if [ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ]; then
    printf '\n  PUSH REFUSED — this is a linked worktree, not the main checkout\n\n' >&2
    exit 1
  fi
  branch="$(git symbolic-ref --short -q HEAD)" || branch=""
  if [ -z "$branch" ]; then
    printf '\n  PUSH REFUSED — HEAD is detached; commits here belong to no branch\n\n' >&2
    exit 1
  fi
  # Force-pushes only. Git already refuses a non-fast-forward; this catches the --force that
  # overrules it, which is the only thing here that destroys somebody else's commits for good.
  printf '%s\n' "$refs" | while read -r _l local_sha _r remote_sha; do
    [ -z "$local_sha" ] && continue
    case "$remote_sha" in
      *[!0]*) git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null || exit 9 ;;
    esac
  done
  if [ $? -eq 9 ]; then
    printf '\n  PUSH REFUSED — this would rewrite history already on the remote\n\n' >&2
    exit 1
  fi
fi

# Is the destination the repository this checkout is allowed to publish to?
remote_url="$2"
repo_path="$(printf '%s' "$remote_url" | sed -e 's#^git@github.com:#github.com/#' -e 's#^https://github.com/#github.com/#' -e 's#\.git$##')"
if [ "$repo_path" != "$ALLOWED_REPO" ]; then
  printf '\n  PUSH REFUSED — destination is %s, not %s\n\n' "$repo_path" "$ALLOWED_REPO" >&2
  printf '  This checkout publishes to one repository. Anything else fails closed.\n\n' >&2
  exit 1
fi

# The gate. Everything about to leave this machine is scanned, not only the last commit.
exec python3 "$(git rev-parse --show-toplevel)/scripts/scan-secrets.py"
