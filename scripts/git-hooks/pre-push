#!/bin/sh
# Refuse a push whose provenance or destination cannot be established, and refuse one whose gates
# have not been run.
#
# This repository was extracted from a monorepo that carried these guards. They came with it
# because the code they protect came with it — a repository that builds a public surface and holds
# no secret scanner is one secret away from a bad afternoon.
#
# The monorepo's version also consults a path allowlist, because that tree mixes proprietary code
# with a publishable website. This one does not: the whole repository is proprietary and the only
# question is whether the destination is private. That is checked against GitHub at push time
# rather than trusted from a config file, because a repository can be flipped to public in two
# clicks long after anyone wrote it down.
set -e
refs="$(cat)"

if [ "$GIT_PUSH_ANYWAY" != "1" ]; then
  if [ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ]; then
    printf '\n  PUSH REFUSED — this is a linked worktree, not the main checkout\n\n' >&2
    exit 1
  fi
  branch="$(git symbolic-ref --short -q HEAD)" || branch=""
  if [ -z "$branch" ]; then
    printf '\n  PUSH REFUSED — HEAD is detached; commits here belong to no branch\n\n' >&2
    exit 1
  fi
  # Force-pushes only. Git already refuses a non-fast-forward; this catches the --force that
  # overrules it, which is the only thing here that destroys somebody else's commits for good.
  printf '%s\n' "$refs" | while read -r _l local_sha _r remote_sha; do
    [ -z "$local_sha" ] && continue
    case "$remote_sha" in
      *[!0]*) git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null || exit 9 ;;
    esac
  done
  if [ $? -eq 9 ]; then
    printf '\n  PUSH REFUSED — this would rewrite history already on the remote\n\n' >&2
    exit 1
  fi
fi

# Is the destination actually private, right now?
remote_url="$2"
repo_path="$(printf '%s' "$remote_url" | sed -e 's#^git@github.com:#github.com/#' -e 's#^https://github.com/#github.com/#' -e 's#\.git$##')"
case "$repo_path" in
  github.com/*)
    name="${repo_path#github.com/}"
    private="$(gh repo view "$name" --json isPrivate -q .isPrivate 2>/dev/null || echo unknown)"
    if [ "$private" != "true" ]; then
      printf '\n  PUSH REFUSED — destination is not verified private (%s)\n\n' "$private" >&2
      printf '  This repository is proprietary. Anything other than a definite yes fails closed.\n\n' >&2
      exit 1
    fi ;;
  *)
    printf '\n  PUSH REFUSED — not a github.com remote, so visibility cannot be checked\n\n' >&2
    exit 1 ;;
esac

# The gates. A push is a claim that this passes; run it rather than assume it.
cd "$(git rev-parse --show-toplevel)/."
npm run check
