---
// The product grid: one deliberate layout for the lab's software products.
// Each card is a terminal-style panel with its own header strip, status rail,
// and live motion. The grid is 4-up on desktop, 2-up on tablet, 1-up on phone,
// and never reflows by accident.
import { PRODUCTS, ALSO, IN_LAB } from '../data/site.ts';

// Each product gets its own glyph so the shelf reads as distinct software,
// not four copies of one card. Glyph names map to the site's inline icon set.
const GLYPH: Record<string, string> = {
  draws: 'terminal',
  weir: 'people',
  machines: 'grid',
  verify: 'key',
};
---

<div class="pgrid" role="list">
  {PRODUCTS.map((p, i) => (
    <a
      class="pcard"
      role="listitem"
      href={p.external ?? p.href ?? '/contact'}
      data-reveal
      style={`--i:${i}`}
      aria-label={`${p.name}: ${p.what}`}
    >
      <div class="pcard-bar">
        <span class="pcard-glyph" data-glyph={GLYPH[p.slug] ?? 'grid'} aria-hidden="true"></span>
        <span class="pcard-path">northlatch/{p.slug}</span>
        <span class="pcard-live"><i></i>LIVE</span>
      </div>
      <div class="pcard-body">
        <h3>{p.name}</h3>
        <p class="pcard-what">{p.what}</p>
        <p class="pcard-for">{p.forYou}</p>
      </div>
      <div class="pcard-foot">
        <span class="pcard-stat">{p.stat}</span>
        <span class="pcard-cta">{p.cta} <span aria-hidden="true">{p.external ? '↗' : '→'}</span></span>
      </div>
      <span class="pcard-scan" aria-hidden="true"></span>
    </a>
  ))}
</div>

<div class="pstrip" data-reveal>
  <div class="pstrip-group">
    <span class="pstrip-label">also live</span>
    {ALSO.map((a) => (
      <a class="pstrip-item" href={a.external ?? a.href}>
        <b>{a.name}</b>
        <span class="tag">[ {a.live} ]</span>
        <span class="pstrip-text">{a.text}</span>
        <span class="pstrip-arrow" aria-hidden="true">{a.external ? '↗' : '→'}</span>
      </a>
    ))}
  </div>
  <div class="pstrip-group">
    <span class="pstrip-label">in the lab</span>
    {IN_LAB.map((a) => (
      <a class="pstrip-item" href={a.href}>
        <b>{a.name}</b>
        <span class="tag">[ {a.live} ]</span>
        <span class="pstrip-text">{a.text}</span>
        <span class="pstrip-arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</div>
