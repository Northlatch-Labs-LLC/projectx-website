---
// Shared commercial layout for Northlatch Labs (northlatch.tech).
// Desktop header stays <= 5 nav links per repository nav-budget guardrail.
import { SITE, PRODUCTS } from '../data/site.ts';

interface Props {
  title: string;
  description: string;
  path: string;
}

const { title, description, path } = Astro.props;
const canonical = SITE.origin + (path === '/' ? '' : path);
const fullTitle = path === '/' ? `${SITE.name} — ${SITE.tagline}` : `${title} — ${SITE.name}`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#090d0b">
  <meta name="color-scheme" content="dark">
  <link rel="icon" href="/svg/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/img/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={SITE.origin + '/img/og-card.png'}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="preload" href="/fonts/jetbrains-mono-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/xl.css">
  <script is:inline src="/js/config.js"></script>
  <script is:inline src="/js/blocks.js" defer></script>
  <script is:inline src="/js/site.js" defer></script>
  <slot name="head" />
</head>
<body id="top">
  <a class="skip" href="#main">Skip to content</a>

  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <symbol id="i-copy" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5.5" y="5.5" width="8" height="8" rx="1"/><path d="M10.5 3V2.5h-8v8H3"/></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
    <symbol id="i-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h9.5M8.5 4l4 4-4 4"/></symbol>
    <symbol id="i-out" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3.5h6.5V10M12.5 3.5 4 12"/></symbol>
    <symbol id="i-check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5 6.5 11.5 12.5 4.5"/></symbol>
  </svg>

  <header class="nav">
    <div class="wrap nav-in">
      <a class="brand" href="/" aria-label={`${SITE.name} home`}>
        <svg class="brand-svg" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <rect x="0.75" y="0.75" width="26.5" height="26.5" rx="6" fill="#101613" stroke="#2c3832" stroke-width="1.5"/>
          <path d="M7.5 8.5L12 14L7.5 19.5" stroke="#e99e00" stroke-width="2.2" stroke-linecap="square" stroke-linejoin="miter"/>
          <path d="M20.5 8.5L16 14L20.5 19.5" stroke="#e99e00" stroke-width="2.2" stroke-linecap="square" stroke-linejoin="miter"/>
          <rect x="13" y="13" width="2" height="2" fill="#eef3f0"/>
        </svg>
        <span class="brand-lockup">
          <span class="brand-name">Northlatch</span>
          <span class="brand-sub">Labs</span>
        </span>
      </a>

      <nav class="nav-links" aria-label="Primary">
        <a href="/#solutions">Solutions</a>
        <a href="/start" aria-current={path === '/start' ? 'page' : undefined}>How to Start</a>
        <a href="/#pricing">Pricing</a>
        <a href="/on-chain" aria-current={path === '/on-chain' ? 'page' : undefined}>Proof</a>
        <a href="/contact" aria-current={path === '/contact' ? 'page' : undefined}>Contact</a>
      </nav>

      <div class="nav-cta">
        <a class="btn btn-primary btn-sm" href="/contact">
          <span>Talk to Sales</span>
          <svg><use href="#i-arrow"/></svg>
        </a>
        <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-panel" aria-label="Toggle navigation menu">
          <svg><use href="#i-menu"/></svg>
        </button>
      </div>
    </div>

    <div class="nav-panel" id="nav-panel" data-open="false">
      <span class="nav-group">Flagship Software</span>
      {PRODUCTS.map((p) => (
        <a href={p.primaryHref}>{p.name} &mdash; {p.category} {p.external ? '↗' : ''}</a>
      ))}
      <a href="/more">Hivex, Kestrel Surgical &amp; Open Stack</a>
      <span class="nav-group">Company &amp; Onboarding</span>
      <a href="/start">How to Become a Customer</a>
      <a href="/#pricing">Transparent Pricing</a>
      <a href="/on-chain">On-Chain Verification &amp; Proof</a>
      <a href="/agents">Autonomous Production Agents</a>
      <a href="/contact">Contact Sales &amp; Custom Builds</a>
      <a class="btn btn-primary" href="/contact">Start a Project &rarr;</a>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <div class="wrap">
      <div class="foot-grid">
        <div class="about">
          <a class="brand" href="/" aria-label={`${SITE.name} home`}>
            <svg class="brand-svg" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
              <rect x="0.75" y="0.75" width="26.5" height="26.5" rx="6" fill="#101613" stroke="#2c3832" stroke-width="1.5"/>
              <path d="M7.5 8.5L12 14L7.5 19.5" stroke="#e99e00" stroke-width="2.2" stroke-linecap="square"/>
              <path d="M20.5 8.5L16 14L20.5 19.5" stroke="#e99e00" stroke-width="2.2" stroke-linecap="square"/>
              <rect x="13" y="13" width="2" height="2" fill="#eef3f0"/>
            </svg>
            <span class="brand-lockup">
              <span class="brand-name">Northlatch</span>
              <span class="brand-sub">Labs</span>
            </span>
          </a>
          <p class="small muted" style="margin-top:16px">
            Commercial AI workforces, local macOS inference, and verifiable Web3/security software built and operated by Northlatch Labs LLC.
          </p>
          <div class="foot-ecosystem" style="margin-top:20px">
            <span class="foot-eco-label">Live Properties</span>
            <nav class="family" aria-label="Northlatch Labs product ecosystem">
              {SITE.family.map((f) => <a href={f.url}>{f.label} &#8599;</a>)}
            </nav>
          </div>
        </div>

        <div>
          <h4>AI &amp; Local Compute</h4>
          <nav aria-label="AI and Compute Solutions">
            <a href="https://synappse.work">Synappse AI Teams &#8599;</a>
            <a href="https://xlaunch.work">Xlaunch Harness &#8599;</a>
            <a href="https://github.com/0xda7/kestrel">Kestrel AI Engine &#8599;</a>
            <a href="https://github.com/Northlatch-Labs-LLC/hivex">Hivex Control Plane &#8599;</a>
            <a href="https://gridframes.app">GridFrames Hosting &#8599;</a>
          </nav>
        </div>

        <div>
          <h4>Verification &amp; Web3</h4>
          <nav aria-label="Verification and Web3 Solutions">
            <a href="/verify">ProtocolX Verify</a>
            <a href="https://protocolx.io">ProtocolX Draws &#8599;</a>
            <a href="/weir">Weir Accounts</a>
            <a href="/on-chain">On-Chain Proof</a>
            <a href="/agents">Autonomous Agents</a>
            <a href="/more">All Open-Source Repos</a>
          </nav>
        </div>

        <div>
          <h4>Company &amp; Legal</h4>
          <nav aria-label="Company and Legal">
            <a href="/start">How to Start</a>
            <a href="/contact">Contact Sales</a>
            <a href="/security">Security Policy</a>
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms of Service</a>
            <a href="/disclaimer">Disclaimer</a>
          </nav>
        </div>
      </div>

      <div class="legal">
        <span>&copy; <span data-year>2026</span> {SITE.legalName}. All rights reserved.</span>
        <span>Open-source repositories at <a href="https://github.com/Northlatch-Labs-LLC">Northlatch-Labs-LLC</a> &amp; <a href="https://github.com/0xda7">0xda7</a> · <a href="/on-chain">Mainnet proof</a></span>
      </div>
    </div>
  </footer>
</body>
</html>
