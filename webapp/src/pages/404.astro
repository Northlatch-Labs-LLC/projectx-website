---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found"
  path="/404"
  description="The requested page could not be found on northlatch.tech."
>
  <Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>
  <section class="page-hero">
    <div class="wrap wrap-narrow center">
      <span class="eyebrow-pill"><i></i>404 &middot; Not Found</span>
      <h1>We couldn't find that page.</h1>
      <p class="lede" style="margin-inline:auto">
        The link you followed may have moved during our site redesign. Explore our live software solutions or reach out to our team below.
      </p>
      <div class="actions" style="justify-content:center">
        <a class="btn btn-primary" href="/">Return Home &rarr;</a>
        <a class="btn btn-ghost" href="/start">Onboarding Guide</a>
        <a class="btn btn-quiet" href="/contact">Contact Sales</a>
      </div>
    </div>
  </section>
</Layout>
