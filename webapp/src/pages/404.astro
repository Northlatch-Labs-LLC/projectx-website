---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Not found" path="/404" description="Nothing lives at this address.">
  <Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>
<section class="page-hero"><div class="wrap wrap-narrow center">
<div class="markfield" data-mark="hero" data-mark-seq="mark,proof" style="aspect-ratio:5/2;border:0;background:transparent;margin-bottom:24px" role="img" aria-label="Blocks building a word."></div>
<p class="cmd"><span data-glyph="ask"></span>$ cd ./here</p><h1>cd: no such directory</h1><p class="lede" style="margin-inline:auto">exit 1. Everything that exists is linked from the top of this page.</p>
<div class="actions" style="justify-content:center"><a class="btn btn-primary" href="/">&larr; cd ~</a><a class="btn btn-ghost" href="/tools">./tools</a></div></div></section>
</Layout>
