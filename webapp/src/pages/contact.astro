---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site.ts';
---

<Layout
  title="Contact Sales & Engineering"
  path="/contact"
  description="Contact Northlatch Labs to scope a custom software build, request a ProtocolX Verify First Report, or discuss enterprise deployments. Reply within one business day."
>
  <Fragment slot="head"><script is:inline src="/js/dev.js" defer></script></Fragment>

  <section class="page-hero">
    <div class="wrap hero-grid" style="align-items:start">
      <div>
        <span class="eyebrow-pill"><i></i>Direct Engineering Access</span>
        <h1>Talk to Northlatch Labs.</h1>
        <p class="lede">
          Whether you want to order a $1,000 Verify First Report, configure a custom ProtocolX campaign, or commission a bespoke software or AI agent build &mdash; describe what you need and receive a concrete scope, price, and timeline within one business day.
        </p>

        <div class="card" style="margin-top:28px">
          <p class="cmd">Direct Email</p>
          <p style="margin-bottom:8px">
            <a class="mail-big" href={`mailto:${SITE.contactEmail}`}>
              <span>&rarr;</span>{SITE.contactEmail}
            </a>
          </p>
          <p class="small faint">Delivered directly to the engineering operator's inbox. No ticket queues or automated sales bots.</p>
          <details style="margin-top:16px">
            <summary class="small muted" style="cursor:pointer">Department addresses (Security, Legal, Privacy)</summary>
            <div class="others-mail">
              <a href={`mailto:${SITE.securityEmail}`}>{SITE.securityEmail}</a>
              <a href={`mailto:${SITE.legalEmail}`}>{SITE.legalEmail}</a>
              <a href={`mailto:${SITE.privacyEmail}`}>{SITE.privacyEmail}</a>
            </div>
          </details>
        </div>
      </div>

      <form class="panel" data-contact novalidate>
        <div class="panel-head">
          <strong>Project &amp; Sales Inquiry</strong>
          <span class="live-pill"><i></i>1-business-day SLA</span>
        </div>
        <div class="bd form-grid">
          <label class="field">
            <span>Your Name *</span>
            <input class="input" name="name" required autocomplete="name" placeholder="Alex Rivera">
          </label>
          <label class="field">
            <span>Work Email *</span>
            <input class="input" name="email" type="email" required autocomplete="email" placeholder="alex@company.com">
          </label>
          <label class="field">
            <span>Solution / Topic *</span>
            <select class="input" name="topic" data-topic-select>
              <option id="topic-sales" value="sales">Custom Build / General Sales</option>
              <option id="topic-synappse" value="synappse">Synappse (Team Plan / Self-Hosting)</option>
              <option id="topic-xlaunch" value="xlaunch">Xlaunch (Harness &amp; Gateway Licensing)</option>
              <option id="topic-kestrel" value="kestrel">Kestrel AI Engine / Kestrel Surgical Pilot</option>
              <option id="topic-hivex" value="hivex">Hivex (Enterprise Control Plane)</option>
              <option id="topic-verify" value="verify">ProtocolX Verify (Hosted App / $1,000 First Report)</option>
              <option id="topic-draws" value="draws">ProtocolX Draws (Promotions &amp; Custom Campaigns)</option>
              <option id="topic-weir" value="weir">Weir (Payouts &amp; Agent Automation)</option>
              <option id="topic-names" value="names">SuiNS Brand Names</option>
              <option id="topic-range" value="range">CTF Security Range (Beta Access)</option>
              <option id="topic-security" value="security disclosure">Security Disclosure</option>
              <option id="topic-press" value="press">Press &amp; Partnerships</option>
            </select>
          </label>
          <label class="field">
            <span>Company / Project (Optional)</span>
            <input class="input" name="company" autocomplete="organization" placeholder="Acme Corp">
          </label>
          <label class="field full">
            <span>How can we help? *</span>
            <textarea class="input" name="message" maxlength="2000" required placeholder="Tell us what you want to launch, your target timeline, and any technical context..."></textarea>
            <span class="hint" data-char-count>0 / 2,000 characters</span>
          </label>
          <div class="hp-field" aria-hidden="true">
            <label>Company website<input type="text" name="company_alt" tabindex="-1" autocomplete="off"></label>
          </div>
          <div class="full" style="display:flex;flex-wrap:wrap;gap:14px;align-items:center">
            <button class="btn btn-primary" type="submit">Send Inquiry &rarr;</button>
            <span data-form-status class="small faint">Direct response within 1 business day</span>
          </div>
        </div>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head" data-reveal>
        <p class="cmd">Engagement Process</p>
        <h2>What happens after you submit.</h2>
      </div>
      <div class="principles">
        <div class="card" data-reveal>
          <span class="n">01 / SAME-DAY REVIEW</span>
          <h3>Read directly by the operator</h3>
          <p>Every inquiry goes straight to our engineering leadership inbox &mdash; never filtered through outsourced support tiers.</p>
        </div>
        <div class="card" data-reveal>
          <span class="n">02 / CLEAR SCOPING</span>
          <h3>Scope, price &amp; timeline in 24h</h3>
          <p>Within one business day you receive a practical answer detailing deliverables, fixed pricing, and realistic launch timing.</p>
        </div>
        <div class="card" data-reveal>
          <span class="n">03 / HONEST FIT CHECK</span>
          <h3>No unnecessary custom builds</h3>
          <p>If one of our self-serve products already solves 100% of your use case, we point you straight to it instead of billing for redundant work.</p>
        </div>
      </div>

      <div class="twocol" style="margin-top:48px">
        <div class="card" data-reveal>
          <p class="cmd">Helpful Context to Share</p>
          <ul class="gets" style="margin-top:12px">
            <li>The business outcome you want to achieve &mdash; no formal technical spec required.</li>
            <li>Your target launch window or deadline.</li>
            <li>Whether you are evaluating self-serve tiers or need custom integrations.</li>
          </ul>
        </div>
        <div class="card" data-reveal>
          <p class="cmd">Common Requests</p>
          <ul class="gets" style="margin-top:12px">
            <li>Custom promotion campaigns &amp; branded raffle flows on ProtocolX.</li>
            <li>First Report ($1,000) or multi-repo rollout for ProtocolX Verify.</li>
            <li>Policy-bounded AI agent automation using Weir accounts &amp; GridFrames compute.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
