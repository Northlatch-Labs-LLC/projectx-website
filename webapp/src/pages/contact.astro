---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact" path="/contact" description="Sales, integration questions, disclosure, or a note.">
  <Fragment slot="head"><script is:inline src="/js/dev.js" defer></script></Fragment>
<section class="page-hero">
  <div class="hero-field" data-field></div>
  <div class="wrap">
    <div class="hero-grid">
      <div><p class="cmd"><span data-glyph="ask"></span>$ ./contact --open</p><h1>Say hello.</h1><p class="lede">Sales, integration questions, disclosure, or a note. Anything on-topic gets a real reply.</p>
        <p style="margin-top:32px"><a class="mail-big" href="mailto:hello@projectxprotocol.dev"><span>&rarr;</span>hello@projectxprotocol.dev</a></p>
        <p class="small faint" style="margin-top:8px">goes to one person. that person is me.</p>
        <details style="margin-top:20px"><summary class="small muted" style="cursor:pointer">&#9656; other addresses</summary>
          <div class="others-mail"><a href="mailto:security@projectxprotocol.dev">security@projectxprotocol.dev</a><a href="mailto:legal@projectxprotocol.dev">legal@projectxprotocol.dev</a><a href="mailto:privacy@projectxprotocol.dev">privacy@projectxprotocol.dev</a></div></details>
      </div>
      <form class="panel" data-contact style="position:relative" novalidate>
        <div class="winbar"><span class="lights" aria-hidden="true"><i></i><i></i><i></i></span><span>$ compose message</span></div>
        <div class="bd form-grid">
          <label class="field"><span>name</span><input class="input" name="name" required autocomplete="name"></label>
          <label class="field"><span>email</span><input class="input" name="email" type="email" required autocomplete="email"></label>
          <label class="field"><span>topic</span><select class="input" name="topic"><option>sales</option><option>verify</option><option>weir</option><option>draws</option><option>names</option><option>range</option><option>security disclosure</option><option>press</option></select></label>
          <label class="field"><span>company (optional)</span><input class="input" name="company" autocomplete="organization"></label>
          <label class="field full"><span>message</span><textarea class="input" name="message" maxlength="500" required></textarea><span class="hint">max 500 chars</span></label>
          <div class="hp-field" aria-hidden="true"><label>Company website<input type="text" name="company_alt" tabindex="-1" autocomplete="off"></label></div>
          <div class="full" style="display:flex;flex-wrap:wrap;gap:12px;align-items:center"><button class="btn btn-primary" type="submit">&rarr; send</button><span data-form-status class="small faint">reply within 1 business day</span></div>
        </div>
      </form>
    </div>
  </div>
</section>
</Layout>
