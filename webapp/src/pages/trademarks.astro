---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Trademarks"
  path="/trademarks"
  description="Trademarks and brand usage guidelines for Northlatch Labs LLC."
>
  <section class="page-hero" style="padding-bottom:28px">
    <div class="wrap wrap-narrow">
      <p class="cmd">Governance</p>
      <h1>Trademarks</h1>
      <p class="lede">Ownership and permitted reference guidelines for Northlatch Labs marks and product names.</p>
    </div>
  </section>

  <section class="section" style="border-top:0;padding-top:0">
    <div class="wrap wrap-narrow">
      <div class="doc-card">
        <div class="doc-section">
          <h2>Protected Marks</h2>
          <p>Northlatch Labs, ProjectX, ProtocolX, ProtocolX Verify, Weir, GridFrames, Xlaunch, Draws, Names, CTF Range, and associated brand marks are trademarks of Northlatch Labs LLC.</p>
        </div>

        <div class="doc-section">
          <h2>Permitted Use</h2>
          <p>You may reference our marks in accurate, factual descriptions of software interoperability or integration. Any use that implies official endorsement or sponsorship without written consent is prohibited.</p>
        </div>

        <div class="doc-section">
          <h2>Brand &amp; Media Inquiries</h2>
          <p>Official brand assets and media kits are available upon request at <a href="mailto:hello@projectxprotocol.dev" class="accent">hello@projectxprotocol.dev</a>.</p>
        </div>

        <div class="doc-meta">Last updated 2026-09-21 &middot; Northlatch Labs LLC</div>
      </div>
    </div>
  </section>
</Layout>
