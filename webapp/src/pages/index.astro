---
// The front door. One idea per band: promise → products → also shipping →
// how (compressed) → start. The jobs router lives on /start; the deep lab
// story lives on /agents and /on-chain. This page stays thin on purpose.
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site.ts';
import ProductGrid from '../components/ProductGrid.astro';
---

<Layout title="Software that runs itself" path="/"
  description="Live products: provably fair draws your community can audit, accounts for people and agents, machines rented in SUI credits, CI verification for Move contracts — plus .sui names and the agent harness. Built by AI, proven on chain.">
<section class="hero">
  <div class="hero-field" data-field></div>
  <div class="wrap">
    <div class="kicker"><span>Northlatch Labs</span><span>Software solutions for business &middot; live on Sui</span></div>
    <h1 style="max-width:26ch">Software that earns trust &mdash; <em>and pays for itself.</em><span class="caret" aria-hidden="true"></span></h1>
    <p class="lede" style="max-width:64ch">Promotions your customers can trust, payouts that reach you directly, hosting without an ops team, and contracts that are checked before they ship. That is what we build — and everything we ship proves it.</p>
    <div class="actions">
      <a class="btn btn-primary" href={SITE.join.url}><svg><use href="#i-arrow"/></svg><span>{SITE.join.label}</span></a>
      <a class="btn btn-ghost" href="/start">Read the 3-minute primer</a>
      <a class="btn btn-quiet" href="/contact">contact</a>
    </div>
    <p class="hero-note">every claim links to a record you can check</p>
  </div>
</section>

<section class="section" id="products">
  <div class="wrap">
    <div class="head" data-reveal>
      <p class="cmd"><span data-glyph="grid"></span>Products</p>
      <h2>Some of our products, live</h2>
      <p>Each one is live right now &mdash; click a card and you are using it, not joining a waitlist.</p>
    </div>
    <ProductGrid />
  </div>
</section>

<section class="section" id="how">
  <div class="wrap">
    <div class="head" data-reveal>
      <p class="cmd"><span data-glyph="bolt"></span>Why you can trust it</p>
      <h2>Why businesses buy from us.</h2>
    </div>
    <div class="platform">
      <div class="card" data-reveal>
        <p><b>Self-serve, priced like a product.</b> Fixed fees, no sales cycle, no waitlists. You decide in the morning and ship with it the same afternoon.</p>
      </div>
      <div class="card" data-reveal>
        <p><b>Proof your customers can check.</b> Draw results come with publicly verifiable evidence — which ends the "was it rigged?" conversation for good. <a href="/on-chain">Every claim here lists its receipt</a>.</p>
      </div>
      <div class="card" data-reveal>
        <p><b>Costs that stay put.</b> 2.9% on draws, locked when you create it. $149 a month per repo, everything included. No setup fees, no per-seat math, no renewal surprises.</p>
      </div>
    </div>
  </div>
</section>

<section class="section" id="door" style="padding-block:64px">
  <div class="wrap">
    <div class="head" data-reveal>
      <p class="cmd"><span data-glyph="play"></span>Get started</p>
      <h2>Three ways to become a customer.</h2>
    </div>
    <div class="platform">
      <a class="prod card" href={SITE.join.url} data-reveal>
        <div class="top"><h3>Self-serve, today</h3><span class="tag tag-live">[ FREE START ]</span></div>
        <p>Create an account with Google or a wallet, then run a draw, rent a machine, or claim a name — within minutes, without talking to anyone.</p>
        <div class="stat">weir.social/join</div>
        <span class="more">create account <svg><use href="#i-out"/></svg></span>
      </a>
      <a class="prod card" href="/start" data-reveal>
        <div class="top"><h3>Evaluate first</h3><span class="tag">[ 3 MIN ]</span></div>
        <p>Three minutes: what each product does for a business like yours, what it costs, and the exact first step for each.</p>
        <div class="stat">no signup needed</div>
        <span class="more">read the primer <svg><use href="#i-arrow"/></svg></span>
      </a>
      <a class="prod card" href="/contact" data-reveal>
        <div class="top"><h3>Custom solution</h3><span class="tag tag-live">[ THE LAB ]</span></div>
        <p>Need something built on top of these rails — a promotion engine, agent automation, private deployment? We build software solutions for businesses. Tell us the problem; you get a scoped answer in one business day.</p>
        <div class="stat">reply within 1 business day</div>
        <span class="more">talk to the lab <svg><use href="#i-arrow"/></svg></span>
      </a>
    </div>
  </div>
</section>
</Layout>
