---
import Layout from '../layouts/Layout.astro';
---
<Layout title="CTF Range" path="/range" description="Eight challenges, 2,800 points, against a retired mainnet deployment.">
<section class="page-hero">
  <div class="hero-field" data-field></div>
  <div class="wrap">
    <div class="hero-grid">
      <div>
        <p class="cmd"><span data-glyph="terminal"></span>$ ./range --describe</p>
        <h1>CTF Range <span class="tag tag-beta">[ BETA ]</span></h1>
        <p class="for">for security leads training engineers</p>
        <p class="lede">Eight challenges, 2,800 points, against a retired mainnet deployment. First bug found before production.</p>
      </div>
      <figure class="markfig"><div class="markfield" data-mark="hero" data-mark-seq="mark,range" role="img" aria-label="Blocks building the X, then the word range."></div></figure>
    </div>
    
  </div>
</section>
<section class="section">
  <div class="wrap twocol">
    <div data-reveal>
      <p class="cmd"><span data-glyph="ask"></span>// problem</p>
      <p class="prob">Engineers meet their first real bug in production. That is the most expensive place to meet it.</p>
    </div>
    <div data-reveal>
      <p class="cmd"><span data-glyph="bolt"></span>// what you get</p>
      <ul class="gets"><li>Eight challenges. 2,800 points.</li><li>Runs against a retired mainnet deployment — real object model, real gas, real edge cases.</li><li>Instructor console, cohort scoreboard, exportable results.</li></ul>
    </div>
  </div>
</section>
<section class="section"><div class="wrap" data-reveal><p class="cmd"><span data-glyph="grid"></span>$ ls ./categories</p><div class="cats"><span>access control</span><span>arithmetic</span><span>object model</span><span>randomness</span><span>upgrade</span><span>gas</span><span>oracles</span><span>cross-package</span></div></div></section>
<section class="section">
  <div class="wrap twocol">
    <div data-reveal>
      <p class="cmd"><span data-glyph="tag"></span>$ pricing</p>
      <div class="pricing"><div><span>team seat</span><b>$150 / engineer / quarter</b></div><div><span>instructor add-on</span><b>$400 / quarter</b></div><div><span>starter team (8 seats)</span><b>$1,200 / quarter</b></div></div>
    </div>
    <div data-reveal>
      <p class="cmd"><span data-glyph="play"></span>$ start</p>
      <div class="startcmds"><span class="lbl">trial</span><div class="cline"><span class="p">$</span><code>range trial --seats 3</code><button class="copy" type="button" data-copy="range trial --seats 3" aria-label="Copy command"><svg><use href="#i-copy"/></svg><span data-copy-label>copy</span></button></div><span class="lbl">cohort</span><div class="cline"><span class="p">$</span><code>range cohort new --name q2-2026</code><button class="copy" type="button" data-copy="range cohort new --name q2-2026" aria-label="Copy command"><svg><use href="#i-copy"/></svg><span data-copy-label>copy</span></button></div></div>
    </div>
  </div>
</section>
<section class="section" style="padding-block:48px"><div class="wrap"><p class="others">more? see the other four: <a href="/verify">./verify</a><a href="/weir">./weir</a><a href="/draws">./draws</a><a href="/names">./names</a></p></div></section>
</Layout>
