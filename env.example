# ProjectX website — configuration template
#
# Copy to .env.local and fill in. Named without the leading dot so the
# scan-secrets guard content-scans it rather than refusing it by filename.
#
# This site signs nothing, holds no wallet key and talks to no database. It does hold one
# read-only API key for the daemon. Both that key and the daemon's hostname are kept
# server-side by never prefixing them with NEXT_PUBLIC_; everything else here is public.

# Where the protocol daemon's read API lives. Server-side only — this value is never
# shipped to the browser, which is why the site needs no entry in the daemon's CORS
# allowlist. Omit it and the site renders the baked snapshot in lib/snapshot.json.
# When this site runs on the same host as the daemon, localhost avoids a network hop.
# From anywhere else on the tailnet, use https://admins-macbook-pro.tail1e9b6b.ts.net/api/v1
PROTOCOL_API_URL=http://localhost:8080/api/v1

# C-2 · The website's API key, scope pool:read only. Issued with
# `npx tsx src/tools/api-key.ts issue` from backend-daemon/; the plaintext is shown once and
# is not recoverable, so a lost key is revoked and reissued rather than looked up.
# Leave it empty while API_AUTH_MODE=report — calls still succeed and are logged as no_key.
# Once the daemon is in enforce mode an empty value means every read returns 401 and the
# site falls back to the baked snapshot.
PROTOCOL_API_KEY=

# The deployed vault interface. Every "Open DApp" control points here. This one is inlined
# into the client bundle, so it must be an origin the visitor's browser can reach — not
# localhost, and not a host only this machine can resolve.
NEXT_PUBLIC_DAPP_URL=https://admins-macbook-pro.tail1e9b6b.ts.net

# This site's own public origin. Used for canonical URLs, Open Graph tags and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:4000
