{
  "name": "@projectx/website",
  "version": "1.0.0",
  "private": true,
  "description": "Presentation website for ProjectX Protocol \u2014 the no-loss prize pool deployed on Sui mainnet.",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
